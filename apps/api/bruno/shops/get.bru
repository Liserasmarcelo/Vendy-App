meta {
  name: Get Shop by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/shops/{{shopId}}
  auth: none
}

headers {
  X-Telegram-Init-Data: {{initData}}
}

assert {
  res.status: eq 200
  res.body.shop: isObject
  res.body.shop.id: isNumber
  res.body.shop.name: isString
  res.body.shop.settings: isObject
  res.body.shop.categories: isArray
  res.body.shop._count: isObject
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("shopName", res.body.shop.name);
    bru.setVar("shopStatus", res.body.shop.status);
  }
}
