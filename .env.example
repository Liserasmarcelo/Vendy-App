# === APP ===
NODE_ENV=development
APP_NAME=Vendy
APP_URL=https://api.vendy.app
FRONTEND_URL=https://app.vendy.app

# === DATABASE ===
DATABASE_URL=postgresql://vendy:vendy_dev_password@localhost:5432/vendy?schema=public

# === REDIS ===
REDIS_URL=redis://localhost:6379

# === TELEGRAM BOTS ===
TELEGRAM_BOT_TOKEN_PARENT=your_bot_father_token_here
TELEGRAM_BOT_TOKEN_CHILD_TEMPLATE=placeholder_for_child_bots
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# === SECURITY ===
JWT_SECRET=your_super_secret_jwt_key_here

# === PAYMENTS ===
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here

# === STORAGE (Cloudflare R2) ===
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=vendy-uploads
R2_PUBLIC_URL=https://pub-your_id.r2.dev

# === MONITORING ===
SENTRY_DSN=https://your_sentry_dsn_here
